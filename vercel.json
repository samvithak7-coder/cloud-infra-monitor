{
    "version": 2,
    "builds": [
        {
            "src": "api/monitor.py",
            "use": "@vercel/python"
        },
        {
            "src": "public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/monitor",
            "dest": "api/monitor.py"
        },
        {
            "src": "/(.*)",
            "dest": "/public/$1"
        }
    ]
}